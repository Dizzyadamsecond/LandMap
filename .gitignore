# ─── Dependencies ───
node_modules/
.pnpm-store/

# ─── Build outputs ───
.next/
out/
dist/
build/
.vercel-root/
*.tsbuildinfo

# ─── tsc emits left in source trees (regenerable; dist/ is the real output) ───
# These get dropped inside packages/*/src when tsc runs without outDir hygiene.
# Use `git clean -f packages/*/src/**/*.js packages/*/src/**/*.d.ts` to sweep.
**/src/**/*.d.ts
**/src/**/*.d.ts.map
**/src/**/*.js

# ─── Logs ───
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Env / secrets (never commit credentials) ───
.env
.env.*
!.env.example

# ─── Editor / OS ───
.DS_Store
*.swp
.vscode/
.idea/

# ─── Local / runtime artifacts ───
.deploy/
.vercel
storybook-static/
coverage/
.nyc_output/

# ─── Backups ───
*.bak

# ─── Stray build dumps at repo root (Next/Tailwind export artifacts, not source) ───
prod.css
prod_page.html

# ─── Local deploy / process temp artifacts (created by helper scripts) ───
*.pid
*.err
*.out
deploy_*.log
validate*.log

# ─── Bug-probe / debug dumps (Playwright probe de produção) ───
.bugprobe/
probe_html.txt

