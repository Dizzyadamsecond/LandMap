{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "outDir": "src",
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@landmap/config": [
        "../config/dist/index.d.ts"
      ],
      "@landmap/db": [
        "../db/dist/index.d.ts"
      ],
      "@landmap/geo": [
        "../geo/dist/index.d.ts"
      ],
      "@landmap/integrations": [
        "../integrations/dist/index.d.ts"
      ],
      "@landmap/invest": [
        "../invest/dist/index.d.ts"
      ],
      "@landmap/llm": [
        "../llm/dist/index.d.ts"
      ],
      "@landmap/llm/*": [
        "../llm/dist/*"
      ],
      "@landmap/sales": [
        "../sales/dist/index.d.ts"
      ],
      "@landmap/sales/*": [
        "../sales/dist/*"
      ],
      "@landmap/automation": [
        "../automation/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}