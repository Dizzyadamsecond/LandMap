{
  "name": "@landmap/api",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/api/src/index.js",
  "types": "dist/api/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api/src/index.d.ts",
      "import": "./dist/api/src/index.js"
    },
    "./platform": {
      "types": "./dist/api/src/platform.d.ts",
      "import": "./dist/api/src/platform.js"
    },
    "./push": {
      "types": "./dist/api/src/push.d.ts",
      "import": "./dist/api/src/push.js"
    },
    "./mailer": {
      "types": "./dist/api/src/mailer.d.ts",
      "import": "./dist/api/src/mailer.js"
    },
    "./routes/sales": {
      "types": "./dist/api/src/routes/sales.d.ts",
      "import": "./dist/api/src/routes/sales.js"
    },
    "./history40": {
      "types": "./dist/api/src/history40.d.ts",
      "import": "./dist/api/src/history40.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/src/index.js",
    "serve": "tsx src/serve.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@landmap/automation": "workspace:*",
    "@landmap/billing": "workspace:*",
    "@landmap/config": "workspace:*",
    "@landmap/db": "workspace:*",
    "@landmap/geo": "workspace:*",
    "@landmap/integrations": "workspace:*",
    "@landmap/invest": "workspace:*",
    "@landmap/llm": "workspace:*",
    "@landmap/sales": "workspace:*",
    "@landmap/scraper": "workspace:*",
    "hono": "4.6.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.1",
    "zod": "3.24.0"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "tsx": "4.19.0",
    "typescript": "5.5.4"
  }
}
